# Infisical Environment Variables
# Required secrets - these must be set before deployment
INFISICAL_JWT_SECRET=change-me-to-a-random-32-hex-string
INFISICAL_POSTGRES_PASSWORD=change-me-to-a-strong-password

# Optional: SMTP configuration (only set if you want email notifications)
# IS_SMTP_ENABLED=false
# IS_SMTP_TLS=false
# IS_SMTP_HOST=
# IS_SMTP_PORT=
# IS_SMTP_USERNAME=
# IS_SMTP_PASSWORD=
# IS_SMTP_FROM_NAME=Infisical
# IS_SMTP_FROM_ADDRESS=

# Optional: Frontend URLs (for HTTPS reverse proxy)
# INFISICAL_LOGIN_ORIGIN=https://secrets.hackfortress.net
# INFISICAL_FRONTEND_WEB_URL=https://secrets.hackfortress.net
